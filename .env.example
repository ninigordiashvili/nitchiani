# Shopify Storefront API
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2025-01"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="995579370374"
NEXT_PUBLIC_INSTAGRAM_HANDLE="Nitchiani.shop"

# Instagram feed (Phase 3) — long-lived access token from Meta for Developers
# Set up via developers.facebook.com → add the Instagram product → run OAuth → exchange for long-lived token
# Without this, the homepage strip falls back to /public/instagram/*.jpg, then to placeholders
INSTAGRAM_ACCESS_TOKEN=""

# Vercel cron secret — protects /api/instagram/refresh-token. Generate any random string.
# Vercel cron jobs send this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Analytics (optional in dev)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# Cal.com
NEXT_PUBLIC_CAL_USERNAME="nitchiani"

# Payments — BOG e-Commerce
# Get from https://api.bog.ge developer portal after merchant onboarding
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
# RSA public key (PEM, single-line ok) used to verify async webhook signatures
BOG_PUBLIC_KEY=""
# Toggle the BOG card option on the checkout UI; flip to "true" once sandbox creds work
NEXT_PUBLIC_BOG_ENABLED="false"

# Payments — TBC Pay (TBC Bank Georgia)
#
# The integration is complete (lib/payments/tbc.ts, /api/checkout/tbc/callback + /webhook) —
# all it needs is merchant credentials. To switch TBC on:
#   1. Onboard as a merchant at https://developers.tbcbank.ge and subscribe to the TPay product
#   2. Fill in all three secrets below
#   3. Set NEXT_PUBLIC_TBC_ENABLED="true"
#
# Steps 2 and 3 go together. The flag only controls whether checkout OFFERS the card option;
# the secrets are what let the server actually charge it. Turn the flag on without the secrets
# and a shopper picks TBC, fills in the whole form, then gets blocked at the last step. The
# boot-time check in lib/payments/config.ts logs a loud error if these ever disagree.
#
# TBC_API_KEY = the apikey header value (subscription key from the developer portal)
# TBC_CLIENT_ID + TBC_CLIENT_SECRET = OAuth credentials
TBC_API_KEY=""
TBC_CLIENT_ID=""
TBC_CLIENT_SECRET=""
NEXT_PUBLIC_TBC_ENABLED="false"

# Cash on delivery — currently withdrawn. Set to "true" to offer it again; this drives both
# the checkout UI and the server-side guard in /api/checkout/initiate.
NEXT_PUBLIC_COD_ENABLED="false"

# Bank transfer details — shown on checkout success
NEXT_PUBLIC_BANK_NAME="Bank of Georgia"
NEXT_PUBLIC_BANK_IBAN=""
NEXT_PUBLIC_BANK_HOLDER="Nitchiani LLC"

# Transactional email (Resend) — fires the order confirmation after manual orders
# Sign up at https://resend.com, verify your sending domain, then drop the API key here.
# Without a key the send is skipped (logged warning) so dev/local still works.
RESEND_API_KEY=""
# Verified sender. Format: "Display Name <orders@yourdomain.com>"
EMAIL_FROM="Nitchiani <orders@nitchiani.shop>"
# Optional studio BCC so the team gets a copy of every confirmation
EMAIL_STUDIO_BCC=""
# Newsletter audience UUID — create one at https://resend.com/audiences, then paste the ID.
# Without this, footer newsletter subscriptions are skipped (logged warning).
RESEND_AUDIENCE_ID=""
